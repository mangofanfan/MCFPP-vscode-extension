{
  "name": "mcfpp",
  "displayName": "MCFPP",
  "description": "MCFPP language support for VS Code",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mcfpp",
        "aliases": [
          "MCFPP",
          "mcfpp"
        ],
        "extensions": [
          ".mcfpp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mcfpp",
        "scopeName": "source.mcfpp",
        "path": "./syntaxes/mcfpp.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "js-yaml": "^5.4.1"
  }
}