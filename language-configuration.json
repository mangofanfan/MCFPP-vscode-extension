{
  "comments": {
    "lineComment": "#",
    "blockComment": [
      "##",
      "##"
    ],
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    },
    {
      "open": "## ",
      "close": "##",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "#{",
      "close": "}#",
      "notIn": [
        "string"
      ]
    }
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*#{.*$",
      "afterText": "^\\s*}#$",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^\\s*##.*$",
      "afterText": "^\\s*##$",
      "action": {
        "indent": "indentOutdent"
      }
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ]
}